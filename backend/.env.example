# Render Postgres connection string (Internal Database URL from Render dashboard)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared secret the grok bot sends as `Authorization: Bearer <secret>`
# or `X-Webhook-Secret: <secret>`. Give this same value to the bot routine.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Your Vercel frontend origin, for CORS. Use * only for local testing.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Local Postgres without SSL? set to "disable". Leave unset for Render.
# PGSSL=disable

# Port (Render sets this automatically)
PORT=3001
